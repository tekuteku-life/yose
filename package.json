{
	"name": "yose",
	"version": "1.16.0",
	"description": "よせあつめ家計簿 - 脱ベンダーロックイン・複式簿記ライクなPWA家計・資産管理システム",
	"type": "module",
	"scripts": {
		"lint:indent": "node scripts/check_indent.js",
		"check:syntax": "node scripts/check_syntax.js",
		"check:types": "tsc --noEmit -p jsconfig.json",
		"check:gas-integrity": "node scripts/sync_gas_integrity.mjs --check",
		"lint": "npm run lint:indent && npm run check:syntax && npm run check:types && npm run check:gas-integrity",
		"test": "npm run lint && node --test --experimental-test-coverage test/unit/*.test.js test/integration/*.test.js test/system/*.test.js",
		"test:unit": "node --test test/unit/*.test.js",
		"test:integration": "node --test test/integration/*.test.js",
		"test:system": "node --test test/system/*.test.js",
		"test:ui": "node --test --test-concurrency=4 test/ui/*.test.js",
		"test:coverage": "node scripts/test_coverage.mjs",
		"setup:gas": "node scripts/setup_gas.js"
	},
	"keywords": [
		"kakeibo",
		"pwa",
		"gas",
		"ed25519"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-instrument": "^6.0.3",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"typescript": "^7.0.2"
	}
}
